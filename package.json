{
	"name": "pdf-splitter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @pdf-splitter/web dev",
		"build": "pnpm --filter @pdf-splitter/web build",
		"preview": "pnpm --filter @pdf-splitter/web preview",
		"prepare": "pnpm --filter @pdf-splitter/web prepare",
		"check": "pnpm --filter @pdf-splitter/web check",
		"check:watch": "pnpm --filter @pdf-splitter/web check:watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"db:migrate:latest": "pnpm --filter @pdf-splitter/database migrate:latest",
		"db:migrate:down": "pnpm --filter @pdf-splitter/database migrate:down"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@vitest/browser": "^3.2.3",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"playwright": "^1.53.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.2.6",
		"vitest": "^3.2.3",
		"vitest-browser-svelte": "^0.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^5.3.31"
	}
}
